# 复制为 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，切勿提交真实口令

# 数据库账号/口令（应用与 PostgreSQL 容器共用；请使用强随机口令）
DB_USER=dockyard
DB_PASSWORD=change-me-to-a-strong-random-password

# 应用首次启动（空库）时创建的首个调度员管理员
# 要求：密码至少 8 位；账号创建并登录改密后，可将这两项从 .env 移除再重启
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
